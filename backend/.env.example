# Local backend environment template.
# Copy these values into backend/.env and replace placeholders with real secrets.

MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/coursecraft?retryWrites=true&w=majority&appName=<app-name>

CORS_ALLOWED_ORIGINS=http://localhost:5173

AI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

JWT_AUTH_ENABLED=false
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=
