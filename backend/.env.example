# Local backend environment template.
# Copy these values into backend/.env and replace placeholders with real secrets.

MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/coursecraft?retryWrites=true&w=majority&appName=<app-name>

CORS_ALLOWED_ORIGINS=http://localhost:5173

AI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=CourseCraft AI
YOUTUBE_API_KEY=

JWT_AUTH_ENABLED=false
LOCAL_DEV_USER_ID=local-dev-user
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=
